# Yahoo Calendar Bridge - Environment Variables

# Yahoo Credentials (choose one method)
YAHOO_USERNAME=your_yahoo_email@example.com
YAHOO_PASSWORD=your_yahoo_password
YAHOO_APP_PASSWORD=your_app_password  # If using app password

# OAuth Tokens (if using OAuth authentication)
OAUTH_TOKEN=your_oauth_access_token
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# Authentication method: app_password, oauth, username_password
AUTH_METHOD=app_password

# CalDAV Endpoint
CALDAV_URL=https://caldav.calendar.yahoo.com/

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=7000

# Default Calendar ID
DEFAULT_CALENDAR_ID=default
